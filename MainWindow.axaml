
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="katalog.MainWindow"
        Title="Mój katalog"
        Width="800"
        Height="450">

    <Grid>
        <StackPanel Name="ListScreen"
                    Margin="20"
                    Spacing="12">
            <TextBlock Text="Mój katalog"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Moje pozycje:"
                       FontSize="18"/>

            <ListBox Name="ItemsList"
                     Height="280"
                     SelectionChanged="OnItemSelected"/>

            <Button Content="Odśwież listę"
                    HorizontalAlignment="Left"
                    Click="OnRefreshClick"/>
        </StackPanel>

        <StackPanel Name="DetailsScreen"
                    Margin="20"
                    Spacing="12"
                    IsVisible="False">
            <Button Content="Powrót do listy"
                    HorizontalAlignment="Left"
                    Click="OnBackClick"/>

            <TextBlock Text="Szczegóły pozycji"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Tytuł"
                       FontWeight="Bold"/>
            <TextBlock Name="TitleText"
                       FontSize="20"/>

            <TextBlock Text="Rok"
                       FontWeight="Bold"/>
            <TextBlock Name="YearText"
                       FontSize="20"/>

            <TextBlock Text="Ocena"
                       FontWeight="Bold"/>
            <TextBlock Name="RatingText"
                       FontSize="20"/>
        </StackPanel>
    </Grid>

</Window>
